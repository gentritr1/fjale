# Copy this file to `.env`, then replace the placeholder values.
# Never commit `.env` or paste its secrets into chat, issues, or screenshots.

# Storage adapter for Rrethi groups and leaderboards.
# `memory` is the safe default: no database is touched, deep health reports
# `database: "disabled"` with 200, and local dev costs nothing.
# Switch to `neon` only when deliberately working against the database.
RRETHI_STORE=memory
# RRETHI_STORE=neon

# Neon Console → Project → Connect → enable Connection pooling → copy the URL.
# The hostname should normally contain `-pooler`.
# Only needed when RRETHI_STORE=neon.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The Neon conformance suite reads its OWN variable — never the production URL —
# and creates/drops a throwaway schema on whatever project this points at.
# Point it at a scratch Neon project, then: npm test
# RRETHI_TEST_NEON_URL=postgresql://USER:PASSWORD@SCRATCH-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Generate once with: openssl rand -hex 32
# Keep the same value after launch; changing it would invalidate member identities.
RRETHI_SERVER_PEPPER=REPLACE_WITH_A_64_CHARACTER_RANDOM_HEX_VALUE

# Shared secret for /api/health?deep=1 (sent as the x-health-token header).
# REQUIRED to enable deep checks when RRETHI_STORE=neon. A missing, malformed,
# or incorrect value fails closed before the endpoint touches the database.
# Generate with: openssl rand -hex 32
# HEALTH_DEEP_TOKEN=REPLACE_WITH_A_RANDOM_VALUE

# Local preview settings.
HOST=127.0.0.1
PORT=3001

# Production uses Postgres's default `public` schema, so no
# RRETHI_PG_SCHEMA setting is needed. Tests create an isolated schema themselves.
